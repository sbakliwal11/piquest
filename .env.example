# Supabase > Project Settings > API (or Connect)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI API key. Server only; never expose with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# OpenAI image generation for optional diagrams; uses the same OPENAI_API_KEY above.
OPENAI_IMAGE_MODEL=gpt-image-1.5
SUPABASE_DIAGRAM_BUCKET=stepwise-diagrams
